# Copy to .env and replace every secret before use outside a local demo.
POSTGRES_PASSWORD=change-this-postgres-password
JWT_SECRET=replace-with-at-least-32-random-bytes
PORT=8080
APP_TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VND

# Optional promotion delivery providers
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
